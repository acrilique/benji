diff --git a/src/discord-gateway_dispatch.c b/src/discord-gateway_dispatch.c
index 0bddeb4..f1507b5 100644
--- a/src/discord-gateway_dispatch.c
+++ b/src/discord-gateway_dispatch.c
@@ -351,7 +351,27 @@ discord_gateway_send_update_voice_state(
         jsonb_key(&b, buf, sizeof(buf), "op", 2);
         jsonb_number(&b, buf, sizeof(buf), 4);
         jsonb_key(&b, buf, sizeof(buf), "d", 1);
-        discord_update_voice_state_to_jsonb(&b, buf, sizeof(buf), event);
+        if (event->channel_id) {
+            discord_update_voice_state_to_jsonb(&b, buf, sizeof(buf), event);
+        }
+        else {
+            /* Discord only disconnects on a null channel_id, and the generated
+             * encoder always writes it as a string. */
+            char guild_id[32];
+            int len = snprintf(guild_id, sizeof(guild_id), "%" PRIu64,
+                               event->guild_id);
+
+            jsonb_object(&b, buf, sizeof(buf));
+            jsonb_key(&b, buf, sizeof(buf), "guild_id", 8);
+            jsonb_string(&b, buf, sizeof(buf), guild_id, (size_t)len);
+            jsonb_key(&b, buf, sizeof(buf), "channel_id", 10);
+            jsonb_null(&b, buf, sizeof(buf));
+            jsonb_key(&b, buf, sizeof(buf), "self_mute", 9);
+            jsonb_bool(&b, buf, sizeof(buf), event->self_mute);
+            jsonb_key(&b, buf, sizeof(buf), "self_deaf", 9);
+            jsonb_bool(&b, buf, sizeof(buf), event->self_deaf);
+            jsonb_object_pop(&b, buf, sizeof(buf));
+        }
         jsonb_object_pop(&b, buf, sizeof(buf));
     }
 
